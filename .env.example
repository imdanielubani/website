APP_NAME="AL.GLOBAL OIL SH.A"
APP_ENV=local
APP_KEY=
# Production: APP_ENV=production and APP_DEBUG=false (debug is forced off in production).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_TIMEZONE=Europe/Tirane
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No database is used.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Production (HTTPS): send the session cookie over HTTPS only.
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email delivery. "log" writes emails to storage/logs/laravel.log (local development).
# On Hostbeak / cPanel, create the mailbox in cPanel > Email Accounts, then use:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps
#   MAIL_HOST=mail.alglobaloilsha.com
#   MAIL_PORT=465
#   MAIL_USERNAME=info@alglobaloilsha.com
#   MAIL_PASSWORD="the mailbox password"
# The FROM address must be the same mailbox as MAIL_USERNAME.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@alglobaloilsha.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Where contact & business inquiry form submissions are delivered.
# Configure MAIL_MAILER (smtp, ses, postmark...) above for real delivery.
# With MAIL_MAILER=log, submissions are written to storage/logs/laravel.log.
INQUIRY_RECIPIENT="info@alglobaloilsha.com"

# Send visitors a branded confirmation email after they submit a form.
INQUIRY_SEND_ACKNOWLEDGEMENT=true

# Keep the site out of search engines (robots.txt, meta robots, X-Robots-Tag).
SITE_NOINDEX=true

# Official company email shown on the site.
COMPANY_EMAIL="info@alglobaloilsha.com"
